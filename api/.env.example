# Copy to .env and fill in. .env is gitignored; this file is not.

PORT=3000
PUBLIC_URL=http://localhost:3000

# Sign JWTs with a long random string. Without it the API generates one per
# boot, which logs every admin out on restart.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# The single admin account.
ADMIN_USERNAME=admin
# Preferred: a bcrypt hash, so no plaintext password lives in the environment.
#   npm run hash-password -- "your-password"
ADMIN_PASSWORD_HASH=
# Convenience for local development only. Hashed at boot, and logs a warning.
ADMIN_PASSWORD=

DATABASE_PATH=data/slate.sqlite
UPLOAD_DIR=data/uploads

# Where the site is served from in development (Vite).
CORS_ORIGINS=http://localhost:5173
