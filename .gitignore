# Dependencies
node_modules/

# Build output
dist/
build/

# Secrets and local state.
# .env holds the admin password hash and the JWT signing secret. Nothing in it
# belongs in a repository — .env.example documents the shape instead.
.env
.env.local
.env.*.local

# The SQLite database and anything uploaded through the admin panel. This is
# runtime content, not source: committing it would ship one machine's release
# list to every other machine.
api/data/
!api/data/.gitkeep

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.sw?
