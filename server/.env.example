# Copy to server/.env and fill in. .env is gitignored; this file is not.
#
# On Vercel you do not use this file — set the same names in
# Project -> Settings -> Environment Variables. Anything marked REQUIRED must be
# set there or the deployment will not start.


# -- Database ----------------------------------------------------------------
#
# REQUIRED in production.
#
# A Postgres connection string. From Neon, take the **pooled** one — its host
# contains "-pooler". A serverless function opens a connection per instance and
# there can be many instances at once, so going through the pooler is what keeps
# you under the connection limit.
#
# Leave DATABASE_URL unset locally and the app uses a SQLite file instead, so a
# fresh clone runs with no credentials and no network. Set it locally too if you
# would rather develop against the real database.
#
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Where the local SQLite file lives when DATABASE_URL is not set.
DATABASE_PATH=data/slate.sqlite

# Print every SQL statement. Noisy; useful when something is not saving.
DATABASE_LOGGING=false

# Last resort for a provider whose certificate Node does not trust. Neon does
# not need this — its certificate chains to a public CA. Turning verification
# off gives up the protection TLS exists to provide, so do not set it "just in
# case".
# DATABASE_SSL_NO_VERIFY=false


# -- Sessions ----------------------------------------------------------------
#
# REQUIRED in production. At least 32 characters.
#
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# Locally, leaving it unset is fine — a random one is generated per run, which
# just means signing in again after a restart. In production it must be set:
# every serverless cold start is a separate process, so without a shared secret
# each instance would sign tokens with a different key and admins would be
# signed out at random.
# JWT_SECRET=

# How long an admin session lasts.
JWT_EXPIRES_IN=12h


# -- The admin account -------------------------------------------------------
#
# One account, no user table. See server/src/auth/auth.service.ts.

ADMIN_USERNAME=admin

# REQUIRED in production. A bcrypt hash, so no plaintext password lives in the
# environment. Generate it with:
#   npm run hash-password -- "your-password"
# ADMIN_PASSWORD_HASH=

# Local convenience only. Hashed at startup, which costs a few hundred
# milliseconds every time the process starts — on serverless that is every cold
# start. Use ADMIN_PASSWORD_HASH in production.
# ADMIN_PASSWORD=


# -- Local server ------------------------------------------------------------
#
# Ignored on Vercel, which routes to the function rather than to a port.

PORT=3000

# Origins allowed to call the API cross-origin. Only matters locally, where Vite
# serves the site on a different port. On Vercel the site and the API share an
# origin and CORS is left off entirely.
CORS_ORIGINS=http://localhost:5173
